{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/ryo-ascii.txt",
        "color": {
            "1": "#D971AA"
        },
        "padding": {
            "top": 0,
            "right": 4
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "#cdd3e0",
            "title": "#D27389"
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "  \u250c\u2500 System \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510",
            "outputColor": "#D27389"
        },
        { "type": "os",       "key": "  OS",       "keyColor": "#6a7a8a" },
        { "type": "kernel",   "key": "  Kernel",   "keyColor": "#6a7a8a" },
        { "type": "uptime",   "key": "  Uptime",   "keyColor": "#6a7a8a" },
        { "type": "packages", "key": "  Packages", "keyColor": "#6a7a8a", "format": "{?pacman}pacman{?}{?flatpak-all}, flatpak{?}" },
        { "type": "shell",    "key": "  Shell",    "keyColor": "#6a7a8a" },
        { "type": "custom",   "format": "  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518", "outputColor": "#D27389" },
        "break",
        {
            "type": "custom",
            "format": "  \u250c\u2500 Hardware \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510",
            "outputColor": "#D27389"
        },
        { "type": "cpu",    "key": "  CPU",     "keyColor": "#6a7a8a" },
        { "type": "custom", "key": "  GPU",     "keyColor": "#6a7a8a", "format": "AMD Radeon RX 7600", "outputColor": "#cdd3e0" },
        { "type": "memory", "key": "  RAM",     "keyColor": "#6a7a8a", "format": "{used} / {total}" },
        { "type": "disk",   "key": "  Root",    "keyColor": "#6a7a8a", "folders": "/",     "format": "{size-used} / {size-total}" },
        { "type": "disk",   "key": "  Home",    "keyColor": "#6a7a8a", "folders": "/home", "format": "{size-used} / {size-total}" },
        { "type": "custom", "format": "  \u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518", "outputColor": "#D27389" },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
